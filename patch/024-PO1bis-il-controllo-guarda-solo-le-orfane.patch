                 "le orfane: una di queste puo' essere gia' registrata in "
                 "CELLE.txt e sembrare in ordine. Decodificala e firma dentro.")
        r.append("")
        for _pi in _ill_tutti:
            r.append("- [ ] `{}`".format(_pi))
