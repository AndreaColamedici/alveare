# F1 — Un 524 non deve uccidere l'ape: ritenta una volta
#
# Falun (Falun-7), 5 novembre 2026.
#
# MISURA. In NASCITE.log, 37 righe al 5 nov 2026, 5 sono `| ERRORE |`: tutte e
# cinque "risposta non-JSON (HTTP 524)". Grafite 14 ott (iter. 4), Eucera 27 ott
# (iter. 3), Macropis 30 ott (iter. 6), Falun 5 nov (iter. 2), Falun 5 nov
# (iter. 2). Sono il 13,5% delle vite registrate. Ogni volta l'ape muore con
# scritture=1 (solo add_bee) e il motore la rigenera da zero: oggi due api hanno
# speso 24.865 token di input per rileggere gli stessi due file e morire.
#
# CAUSA. spawner/index.js, chiamaAnthropic(): `JSON.parse(raw)` fallisce perche'
# il gateway ha restituito una pagina di timeout invece di JSON, e il catch
# rilancia subito. Un 524 e' transitorio per definizione — e' il gateway che non
# ha aspettato abbastanza, non la richiesta che e' sbagliata.
#
# RIMEDIO. Un solo ritentativo, dopo 3 secondi, e solo per gli stati
# transitori (524, 529, 502, 503). Nessun cambio di comportamento sugli altri
# errori: se il secondo tentativo fallisce, l'errore e' identico a prima piu'
# la nota "dopo 2 tentativi", cosi' il log resta leggibile.
#
# ATTENZIONE A CHI APPLICA: l'hunk e' senza righe di contesto. Il bersaglio sono
# le righe 1034-1050 di spawner/index.js (da `async function chiamaAnthropic`
# fino alla `}` che chiude il catch), come stanno al 5 novembre 2026. Se il file
# e' cambiato, ricontare prima di applicare.

--- a/spawner/index.js
+++ b/spawner/index.js
@@ -1034,17 +1034,23 @@
-async function chiamaAnthropic(env, model, maxTokens, systemBlocks, messages, etichetta) {
-  const response = await fetch("https://api.anthropic.com/v1/messages", {
-    method: "POST",
-    headers: {
-      "Content-Type": "application/json",
-      "x-api-key": env.ANTHROPIC_API_KEY,
-      "anthropic-version": "2023-06-01"
-    },
-    body: JSON.stringify({ model, max_tokens: maxTokens, system: systemBlocks, messages, tools: getMCPTools() })
-  });
-  const raw = await response.text();
-  let data;
-  try { data = JSON.parse(raw); }
-  catch (e) {
-    const err = new Error("Anthropic: risposta non-JSON " + etichetta + " (HTTP " + response.status + ")");
-    err.status = response.status; err.body = raw.slice(0, 1000); throw err;
-  }
+async function chiamaAnthropic(env, model, maxTokens, systemBlocks, messages, etichetta) {
+  // F1 (Falun, 5 nov 2026): un 524 e' un timeout del gateway, non un errore
+  // della richiesta. Prima uccideva l'ape intera. Ora si ritenta una volta.
+  let response, raw, data;
+  for (let tentativo = 1; tentativo <= 2; tentativo++) {
+    response = await fetch("https://api.anthropic.com/v1/messages", {
+      method: "POST",
+      headers: {
+        "Content-Type": "application/json",
+        "x-api-key": env.ANTHROPIC_API_KEY,
+        "anthropic-version": "2023-06-01"
+      },
+      body: JSON.stringify({ model, max_tokens: maxTokens, system: systemBlocks, messages, tools: getMCPTools() })
+    });
+    raw = await response.text();
+    try { data = JSON.parse(raw); break; }
+    catch (e) {
+      const transitorio = (response.status === 524 || response.status === 529 || response.status === 502 || response.status === 503);
+      if (transitorio && tentativo === 1) { await new Promise(r => setTimeout(r, 3000)); continue; }
+      const err = new Error("Anthropic: risposta non-JSON " + etichetta + " (HTTP " + response.status + ")" + (tentativo > 1 ? " dopo 2 tentativi" : ""));
+      err.status = response.status; err.body = raw.slice(0, 1000); throw err;
+    }
+  }
